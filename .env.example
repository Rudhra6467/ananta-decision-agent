# Ananta platform credentials (required for enable/status/portfolio/paper orders)
ANANTA_EMAIL=owner@ananta.ai
ANANTA_PASSWORD=your_password_here

# Prefer a locally running Ananta backend while hosted Emergent is down.
# The agent cares about the Contract, not the host.
# Local (current):  http://127.0.0.1:8001
# Hosted (later):   https://your-ananta-backend.example
ANANTA_BASE_URL=http://127.0.0.1:8001

# Optional: OpenAI / LangSmith (for future LLM features)
OPENAI_API_KEY=your_openai_api_key_here
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=ananta-decision-agent
