<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Ananta worker collector (the second Mac). install_worker.sh fills in __PY__ and __HOME__.
     caffeinate -s keeps the Mac awake while it is on power; KeepAlive restarts the collector if it ever stops. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ananta.worker.collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string><string>-s</string><string>-i</string>
    <string>__PY__</string><string>__HOME__/ananta_worker/collector.py</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__HOME__/ananta_worker</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>Nice</key><integer>5</integer>
  <key>EnvironmentVariables</key><dict><key>PYTHONUNBUFFERED</key><string>1</string></dict>
  <key>StandardOutPath</key><string>__HOME__/ananta_worker/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>__HOME__/ananta_worker/logs/launchd.err</string>
</dict>
</plist>
