{
  "expo": {
    "name": "Jarvis",
    "slug": "jarvis",
    "version": "0.3.0",
    "scheme": "jarvis",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F6F8",
    "ios": {
      "bundleIdentifier": "com.rudhra.jarvis",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Jarvis asks for Face ID before approving changes or touching the kill switch.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-status-bar"
    ],
    "extra": {
      "defaultServer": "http://192.168.2.68:8100"
    }
  }
}
