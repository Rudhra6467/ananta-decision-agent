{
  "expo": {
    "name": "Ananta",
    "slug": "jarvis",
    "version": "0.4.0",
    "scheme": "jarvis",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#141518",
    "ios": {
      "bundleIdentifier": "com.rudhra.jarvis",
      "supportsTablet": false,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Ananta asks for Face ID before approving changes or touching the kill switch.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "Ananta"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-notifications",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Ananta listens when you hold the mic button to talk to it."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#08090B",
          "resizeMode": "contain"
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "defaultServer": "https://api.livetrading247.com",
      "router": {},
      "eas": {
        "projectId": "3ff1c9db-f59c-41a6-b61f-de379d389a04"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "name": "Jarvis · Ananta"
    },
    "icon": "./assets/icon.png",
    "owner": "vamsiadvs"
  }
}
