<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The outside watchdog (scripts/jarvis_watchdog.py): every 5 minutes, is Jarvis answering? Installed by scripts/install_watchdog.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ananta.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>set -a; source __HOME__/code/ananta-decision-agent/.env; set +a; /usr/bin/python3 __REPO__/scripts/jarvis_watchdog.py >> __HOME__/ananta_runs/watchdog.log 2>&amp;1</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
</dict>
</plist>
