<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Other traders against Ananta, every day (src/research/others_daily.py; Madhav, Oct 20: "why wait?"). Reference only (D8).
     04:30 Toronto time, after the 03:40 backup has pulled the worker's finished days (hl_YYYY-MM-DD.sqlite) into ~/ananta_worker_data.
     Each run does every day of the last 7 that has a day file and no report yet, so a missed night catches up by itself.
     NOT installed by anything: fill in __REPO__ and __HOME__ and load it by hand (the steps are in worker/README.md). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ananta.othersdaily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/ananta_venvs/jarvis/bin/python</string><string>-m</string><string>src.research.others_daily</string><string>run</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PYTHONPATH</key><string>__REPO__</string>
    <key>JARVIS_AGENT_DIR</key><string>__HOME__/code/ananta-decision-agent</string>
  </dict>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>4</integer><key>Minute</key><integer>30</integer></dict>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/ananta_runs/others_daily.log</string>
  <key>StandardErrorPath</key><string>__HOME__/ananta_runs/others_daily.log</string>
</dict>
</plist>
